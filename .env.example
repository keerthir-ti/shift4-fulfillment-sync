# Simulators, on loopback only. Not Shift4's tenant.
WEB_PORT=3000
ORACLE_PORT=4010
FOUNDRY_PORT=4020
CONNECTOR_PORT=4030
ORACLE_URL=http://127.0.0.1:4010
FOUNDRY_URL=http://127.0.0.1:4020
CONNECTOR_URL=http://127.0.0.1:4030
DATA_DIR=.local
SCENARIO_ID=local-demo
# accelerated = 60s snapshot. fifteen-minute = selected 15-minute schedule, not a measured replica.
PROFILE=accelerated
# Workflow path. off = today's behaviour.
FULFILLMENT_SYNC=off
TEMPORAL_ADDRESS=127.0.0.1:7243
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-delivery
TEMPORAL_ORACLE_TASK_QUEUE=oracle-reads
# TEMPORAL_API_KEY=            # Temporal Cloud only
# Ports for the local dev server.
TEMPORAL_PORT=7243
TEMPORAL_UI_PORT=8243
# Oracle-reading activities per second across all workers. One activity can make several HTTP calls.
# Placeholder until the real limit is known.
ORACLE_ACTIVITIES_PER_SECOND=1
# Optional: where Overdue and ActionRequired events are posted.
# DELIVERY_ALERT_WEBHOOK_URL=
# Optional: Prometheus port for worker metrics.
# WORKER_METRICS_PORT=9464
# Worker identity. The simulators ignore these.
# ORACLE_AUTHORIZATION=
# FOUNDRY_AUTHORIZATION=
# WORKER_HEALTH_PORT=4040
